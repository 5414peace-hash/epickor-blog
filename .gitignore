# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log

# env files (can opt-in for committing if needed)
.env*

# local automation/runtime artifacts
/output/*
# ...except the social performance record, which must accumulate across sessions/machines.
# Git will not descend into an excluded directory, so each level has to be re-opened
# explicitly and then re-closed, or the multi-GB reels/ media would start getting tracked.
!/output/reels/
!/output/strategy/
/output/strategy/*
!/output/strategy/keywords_*.md
!/output/strategy/keyword-bets.csv
!/output/strategy/cluster-backlog.md
!/output/strategy/cluster-map.md
!/output/strategy/package_*.md
# Section/corner decisions. Same reason as the baselines below: this records why a
# section was or was not created, and an untracked copy is gone the moment the
# session ends. 2026-08-13's brainstorm was silently swallowed by the /* rule above.
!/output/strategy/section_*.md
!/output/strategy/section_*.json
!/output/strategy/business-candidates_*.md
# Measurement baselines. These are the ONLY record of what a metric looked like
# before an intervention; once the window passes, an untracked one cannot be
# reconstructed from anything. Losing this file does not degrade the experiment,
# it deletes it.
!/output/strategy/cluster-baseline_*.json
!/output/strategy/cluster-baseline_*.md
!/output/strategy/refresh-baseline.json
!/output/strategy/refresh-baseline.md
# The GSC exports the baselines are computed from. 513KB for the full set, and
# without them no future session can re-derive or audit a baseline number.
!/output/gsc/
/output/gsc/*
!/output/gsc/*/
/output/gsc/*/*
!/output/gsc/*/페이지.csv
!/output/gsc/*/차트.csv
!/output/gsc/*/검색어 수.csv
!/output/gsc/*/필터.csv
/output/reels/*
!/output/reels/metrics.json
!/output/reels/*.md
# Per-Reel text: scripts, source provenance, and the two JSON files the Remotion
# compositions import at build time. Without these a clean checkout fails to compile.
# Media (video/audio/renders) stays excluded - the 2026-07-26 batch alone is 313MB.
!/output/reels/*/
/output/reels/*/*
!/output/reels/*/*.md
!/output/reels/*/caption-timings-*.json
!/output/reels/*/remotion-props-*.json
# render-manifest.json and the cut plans are also build-time imports (HubReels.tsx,
# Batch0811Reels.tsx). They were previously force-added, which meant a clean
# checkout of a new batch would not compile until someone remembered `git add -f`.
!/output/reels/*/render-manifest.json
!/output/reels/*/cut-plan-*.json
!/output/reels/*/media-report.json
# Per-reel build scripts. prep-plates.mjs holds the hand-chosen crop boxes and
# rebuild-timeline.mjs derives the cut plan from the forced alignment — the media
# itself is ignored, so these scripts are the only record of how it was made, and
# the only way to regenerate it from the committed post images.
!/output/reels/*/*.mjs
# CLAUDE.md mandates the continuity manifest ("probe every selected video with ffprobe
# and record ... in continuity-manifest.json"), but it was never whitelisted, so only
# hub-drinks had one tracked — via a stray `git add -f`. The 2026-08-11 folder rename
# would have dropped that one silently, since the new path was ignored.
!/output/reels/*/continuity-manifest.json
# The narration scripts and the upload caption are the most reusable text a Reel
# produces and were silently untracked — only *.md was allowed through.
!/output/reels/*/voice-part-*.txt
!/output/reels/*/instagram-caption.txt
!/output/reels/*/tts/
/output/reels/*/tts/*
!/output/reels/*/tts/*.txt
# The delivered package moved here on 2026-08-11 (was output/final/reels/). The
# MP4 stays ignored; the upload text does not — instagram-caption.txt and
# upload-package.md were tracked at the reel root before the move and would have
# dropped out of the repo silently.
!/output/reels/*/final/
/output/reels/*/final/*
!/output/reels/*/final/*.txt
!/output/reels/*/final/*.md
/.tmp/
/.history/
/history/
/history reels/
/.codex-deploy/
/.claude/settings.local.json
/epickor-agent-design-v2.md
/package-lock.json
/public/assets/reels/

# Raw BGM/audio source library (65MB+ of mp3s, licence/origin not yet confirmed
# with the representative) - keep local-only, same reasoning as public/assets/reels/.
/input/

# Meta Business Suite local automation artifacts
/tools/meta-suite-helper/browser-profile/
/tools/meta-suite-helper/runs/
/tools/meta-suite-helper/*.log
/tools/meta-suite-helper/batch_result.json
/tools/meta-suite-helper/last_controls.json
/tools/meta-suite-helper/meta_schedule_queue.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GSC service account key - NEVER commit (grants read access to Search Console)
/.gsc-service-account.json
/output/gsc/api/
