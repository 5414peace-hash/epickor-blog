# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log

# env files (can opt-in for committing if needed)
.env*

# local automation/runtime artifacts
/output/*
# ...except the social performance record, which must accumulate across sessions/machines.
# Git will not descend into an excluded directory, so each level has to be re-opened
# explicitly and then re-closed, or the multi-GB reels/ media would start getting tracked.
!/output/reels/
!/output/strategy/
/output/strategy/*
!/output/strategy/keywords_*.md
!/output/strategy/keyword-bets.csv
/output/reels/*
!/output/reels/metrics.json
!/output/reels/*.md
# Per-Reel text: scripts, source provenance, and the two JSON files the Remotion
# compositions import at build time. Without these a clean checkout fails to compile.
# Media (video/audio/renders) stays excluded - the 2026-07-26 batch alone is 313MB.
!/output/reels/*/
/output/reels/*/*
!/output/reels/*/*.md
!/output/reels/*/caption-timings-*.json
!/output/reels/*/remotion-props-*.json
!/output/reels/*/tts/
/output/reels/*/tts/*
!/output/reels/*/tts/*.txt
/.tmp/
/.history/
/history/
/history reels/
/.codex-deploy/
/.claude/settings.local.json
/epickor-agent-design-v2.md
/package-lock.json
/public/assets/reels/

# Raw BGM/audio source library (65MB+ of mp3s, licence/origin not yet confirmed
# with the representative) - keep local-only, same reasoning as public/assets/reels/.
/input/

# Meta Business Suite local automation artifacts
/tools/meta-suite-helper/browser-profile/
/tools/meta-suite-helper/runs/
/tools/meta-suite-helper/*.log
/tools/meta-suite-helper/batch_result.json
/tools/meta-suite-helper/last_controls.json
/tools/meta-suite-helper/meta_schedule_queue.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GSC service account key - NEVER commit (grants read access to Search Console)
/.gsc-service-account.json
/output/gsc/api/
